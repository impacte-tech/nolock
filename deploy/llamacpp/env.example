# llama.cpp service variables (Railway)
# The model is pulled from HuggingFace at startup — change these to swap models
# without touching the image.

# --- Model (HuggingFace) ----------------------------------------------------
# HF repo id (GGUF format). llama.cpp downloads it on first start.
LLAMA_ARG_HF_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF

# Optional: pin a specific GGUF file in the repo. If omitted, llama.cpp picks
# a quant automatically (usually Q4_K_M).
# LLAMA_ARG_HF_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf

# --- Server tuning ----------------------------------------------------------
# Context window in tokens. Keep modest on CPU (Railway hobby ≈ 512MB–1GB RAM).
LLAMA_ARG_CTX_SIZE=4096

# Parallel server slots (each holds its own KV cache — costs RAM).
LLAMA_ARG_N_PARALLEL=1

# GPU layers. Leave 0 on a CPU-only instance; set to e.g. 99 on a GPU instance
# (and switch the Dockerfile base to ghcr.io/ggml-org/llama.cpp:server-cuda).
LLAMA_ARG_N_GPU_LAYERS=0

# Optional: require an API key on the llama.cpp server itself.
# LLAMA_ARG_API_KEY=change-me

# --- Aliases (optional) -----------------------------------------------------
# Friendlier names if you prefer them over LLAMA_ARG_*:
# HF_MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
# HF_MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf