# llama.cpp wrapper service (Railway). Mount the existing volume at /models.
NOLOCK_MODEL_DIR=/models
LLAMA_CACHE=/models
PORT=8080
NOLOCK_MODEL_STORE_PORT=8081

# Current production model; preserves the existing cached download.
# Alternatively set LLAMA_ARG_MODEL to a path returned by a completed UI pull.
MODEL_HF=impacte/ullr:Q4_K_M
# LLAMA_ARG_MODEL=/models/pulled/owner/repo/<revision>/model.gguf
# LLAMA_ARG_HF_REPO=owner/model-GGUF:Q4_K_M
# LLAMA_ARG_HF_FILE=model-q4_k_m.gguf

LLAMA_ARG_CTX_SIZE=4096
LLAMA_ARG_THREADS=4
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_N_GPU_LAYERS=0

# Required on both nolock and llamacpp: generate a random shared secret.
# NOLOCK_MODEL_PULL_TOKEN=

# Optional; set only on llamacpp for gated/private Hugging Face repositories.
# HF_TOKEN=
# Optional inference API key (independent of the model-store token):
# LLAMA_ARG_API_KEY=
