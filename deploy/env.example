# nolock-server environment variables (Railway web deployment)
# Copy the ones you need into your Railway service variables.

# --- Server ---
# Railway injects PORT automatically; the server binds 0.0.0.0:$PORT.
# PORT=8080

# Folder containing the built web frontend (set in the Dockerfile).
# NOLOCK_WEB_DIST=/app/public

# --- Writable data directory ---
# Where nolock stores server-side state: the secrets store (secrets.json),
# RLHF logs (.rlhf/) and any opened project folders. Point it at a Railway
# volume mount so data survives redeploys and restarts.
#
# Default: ~/.nolock-web (HOME of the running user) when unset.
# Railway volume mounted at /data:
NOLOCK_DATA_DIR=/data/nolock

# --- Security (recommended for public deployments) ---
# When set, every /api request requires this token — either an
# "Authorization: Bearer <token>" header or "?token=<token>" in the URL
# (needed for the SSE EventSource and file links, which cannot set headers).
# Open the app as https://<your-domain>/?token=<value> and the frontend
# shims pick it up automatically (login page / URL pre-fill).
#
# Generate with: openssl rand -hex 32
# (No default — leave unset to disable auth; strongly discouraged on public URLs.)
NOLOCK_WEB_TOKEN=77be7314c9e5712a64267b3224c845170e476a7f0a41f6e550e753333dd0d831

# --- llama.cpp inference service (optional) ---
# Private-network URL of the isolated llama.cpp service in the same Railway
# project. The web frontend auto-wires this into the llama.cpp model provider
# via GET /api/config (no manual URL entry needed).
#
# Uses Railway's private DNS (<service>.railway.internal) — NOT exposed publicly.
# The llama.cpp service is configured with MODEL_HF + LLAMA_CACHE (see
# deploy/llamacpp/env.example).
LLAMACPP_URL=http://llamacpp.railway.internal:8080

# --- AI backends (optional; the app also stores keys in its UI) ---
# The desktop app reads provider keys from the OS keychain. On the web the
# UI-stored keys (localStorage) and the server-side secret store are used.
# NOLOCK_OPENROUTER_API_KEY=

# --- UI model pulls -------------------------------------------------------
# Private worker running inside the llama.cpp container on its /models volume.
# Requires deploy/llamacpp/Dockerfile (the raw inference image lacks this API).
LLAMACPP_MODEL_STORE_URL=http://llamacpp.railway.internal:8081
# Same random secret as the llamacpp service. Never exposed by /api/config.
# NOLOCK_MODEL_PULL_TOKEN=
